# Skopiuj do pliku .env i uzupełnij.

# Adres bazy PostgreSQL.
# Supabase: Project Settings → Database → Connection string → URI (z hasłem bazy).
#   np. postgresql://postgres.abcdefgh:HASLO@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Lokalnie / Docker: postgresql://mxt:mxt@localhost:5432/mxt
DATABASE_URL=postgresql://mxt:mxt@localhost:5432/mxt

# 1 = połączenie z bazą przez SSL (wymagane w Supabase i większości baz w chmurze), 0 = lokalnie
DATABASE_SSL=0

# Port aplikacji
PORT=3000

# 1 gdy aplikacja działa pod HTTPS (produkcja), 0 przy testach po http://localhost
COOKIE_SECURE=0

# 1 gdy aplikacja stoi za reverse proxy (Caddy, nginx, Render, Railway…)
TRUST_PROXY=0

# Ile dni pamiętać zalogowanie
SESSION_DAYS=30

# --- Agenci AI (etap 2) ---
# test = odpowiedzi symulowane z danych systemu, bez wywołań modelu i bez kosztów (domyślnie)
# live = agenci korzystają z Claude (wymaga ANTHROPIC_API_KEY); wywołania są płatne i liczone w limitach kosztów agentów
AI_MODE=test
ANTHROPIC_API_KEY=

# --- Poczta (etap 4) – bez SMTP_HOST wiadomości są zapisywane w trybie testowym i nie wychodzą ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0                        # 1 dla portu 465 (SSL)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MXT <biuro@twojafirma.pl>
APP_URL=https://mxt.twojafirma.pl    # adres aplikacji w e-mailach
# PUSH_CONTACT=mailto:it@twojafirma.pl   # opcjonalnie: kontakt dla usług push (domyślnie APP_URL)

# --- Automatyzacje i integracje (etap 4) ---
MXT_SECRET_KEY=                      # min. 32 znaki – szyfruje sekrety webhooków (puste = klucz w bazie)
N8N_ALLOWED_HOSTS=                   # np. n8n.local – hosty dozwolone dla webhooków http / sieci wewnętrznej
WORKERS=1                            # 0 = ta instancja nie uruchamia kolejki ani harmonogramu

# --- Monitoring AI: Langfuse (opcjonalnie) ---
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_INCLUDE_CONTENT=0           # 1 = wysyłaj też treść zapytań i odpowiedzi
