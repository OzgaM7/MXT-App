# MXT Recepcja AI – skopiuj do .env i uzupełnij. Pliku .env nie wysyłaj do repozytorium.

# --- AI ---
ANTHROPIC_API_KEY=
# Model asystentki (plan: Haiku 5.5; trudniejsze sprawy: claude-sonnet-5-5, drożej)
ANTHROPIC_MODEL=claude-haiku-5-5
DEEPGRAM_API_KEY=
# 1 = Deepgram lepiej rozpoznaje słowa firmy (MXT, podzielnik…); 0, gdyby odrzucał połączenie
DEEPGRAM_SLOWA_KLUCZOWE=1
# Głos: cartesia albo elevenlabs (wybór po odsłuchu polskich głosów)
TTS=cartesia
CARTESIA_API_KEY=
# ID polskiego głosu z Cartesia Playground
CARTESIA_VOICE_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# 1 = jednozdaniowe podsumowanie rozmowy przez Claude (ułamek centa), 0 = z danych rozmowy
PODSUMOWANIE_AI=1

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numer firmy w Twilio, format +48… (nadawca SMS i numer pokazywany przy przekazaniu)
TWILIO_NUMER=
# Adres serwera bota widziany przez Twilio, np. https://recepcja-mxt.onrender.com (przy testach: adres ngrok)
PUBLIC_URL=
# 1 = sprawdzanie podpisu Twilio (zawsze na produkcji)
TWILIO_WALIDACJA=1
# Numer pracownika do przekazania rozmowy, format +48…
TRANSFER_NUMBER=
# 1 = nagrywanie rozmów (asystentka mówi o nim w powitaniu; koszt 0,0025 USD/min)
NAGRYWANIE=0
# 1 = SMS z potwierdzeniem terminu
SMS_WLACZONE=0

# --- aplikacja MXT ---
MXT_APP_WEBHOOK_URL=https://mxt-4o5e.onrender.com/api/asystent/webhook
# Z aplikacji MXT: Asystent telefoniczny → Integracja z botem → Wygeneruj klucz
MXT_APP_WEBHOOK_TOKEN=
# 1 = rozmowy telefoniczne zapisywane w aplikacji jako testowe (bez zleceń i statystyk) – na czas testów etapu 2
ROZMOWY_TESTOWE=0

# --- kalendarz ---
# lokalny (SQLite) albo google
KALENDARZ=lokalny
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_KALENDARZ_ID=
# Osobne kalendarze działów (opcjonalnie):
# GOOGLE_KALENDARZ_PODZIELNIKI=
# GOOGLE_KALENDARZ_UBEZPIECZENIA=
BAZA_SQLITE=recepcja.db

# --- inne ---
TAXI_WLACZONE=0
# Numer „dzwoniącego” w rozmowach testowych w przeglądarce
TEST_TELEFON=
